
abstract class Vehicle {
    String regNo;

    Vehicle(String regNo) {
        this.regNo = regNo;
    }

    abstract double calculateFee();
}

interface Chargeable {
    double chargingFee(int units);
}

class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }

    double calculateFee() {
        return 30;
    }
}

class Bike extends Vehicle {
    Bike(String regNo) {
        super(regNo);
    }

    double calculateFee() {
        return 10;
    }
}

class ElectricCar extends Vehicle implements Chargeable {
    ElectricCar(String regNo) {
        super(regNo);
    }

    double calculateFee() {
        return 30;
    }

    public double chargingFee(int units) {
        return units * 12;
    }
}

public class Main {
    public static void main(String[] args) {

        Vehicle v1 = new Car("TN01A1");
        Vehicle v2 = new Bike("TN02B2");
        ElectricCar v3 = new ElectricCar("TN03C3");

        System.out.println("Car Fee: " + v1.calculateFee());
        System.out.println("Bike Fee: " + v2.calculateFee());
        System.out.println("Electric Car Fee: " + v3.calculateFee());
        System.out.println("Charging Fee: " + v3.chargingFee(5));
    }
}
