
class ParkingLot {
    String[] vehicles = new String[5];

    void park(String number, int slot) {

        if (slot < 1 || slot > 5) {
            System.out.println("Invalid slot");
            return;
        }

        if (vehicles[slot - 1] != null) {
            System.out.println("Slot already occupied");
            return;
        }

        for (String v : vehicles) {
            if (number.equals(v)) {
                System.out.println("Duplicate vehicle");
                return;
            }
        }

        vehicles[slot - 1] = number;
        System.out.println(number + " parked in slot " + slot);
    }

    void exit(String number) {

        for (int i = 0; i < vehicles.length; i++) {

            if (number.equals(vehicles[i])) {
                vehicles[i] = null;
                System.out.println(number + " exited");
                return;
            }
        }

        System.out.println("Vehicle not found");
    }

    void display() {
        System.out.println("Parking Details");

        for (int i = 0; i < vehicles.length; i++) {
            System.out.println("Slot " + (i + 1) + ": " +
                (vehicles[i] == null ? "Empty" : vehicles[i]));
        }
    }
}

public class Main {
    public static void main(String[] args) {

        ParkingLot p = new ParkingLot();

        p.park("TN01A1", 1);
        p.park("TN02B2", 2);
        p.park("TN03C3", 1);
        p.park("TN01A1", 3);
        p.park("TN04D4", 8);

        p.display();

        System.out.println("\nVehicle Exit");

        p.exit("TN01A1");
        p.exit("TN99Z9");

        p.display();
    }
}
