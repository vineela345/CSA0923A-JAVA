
class Vehicle {
    private final String regNo;

    Vehicle(String regNo) {
        this.regNo = regNo;
    }

    public String getRegNo() {
        return regNo;
    }

    public double calculateFee() {
        return 20;
    }

    @Override
    public boolean equals(Object obj) {
        if (obj instanceof Vehicle) {
            Vehicle v = (Vehicle) obj;
            return regNo.equals(v.regNo);
        }
        return false;
    }

    @Override
    public int hashCode() {
        return regNo.hashCode();
    }
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String regNo) {
        super(regNo);
    }

    @Override
    public double calculateFee() {
        return 10;
    }
}

class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }

    @Override
    public double calculateFee() {
        return 30;
    }
}

public class Main {
    public static void main(String[] args) {
        TwoWheeler bike = new TwoWheeler("TN01A1");
        Car car = new Car("TN02B2");

        System.out.println("Bike Fee: " + bike.calculateFee());
        System.out.println("Car Fee: " + car.calculateFee());

        Car c1 = new Car("TN02B2");
        Car c2 = new Car("TN02B2");

        System.out.println(c1.equals(c2));
        System.out.println(c1.hashCode() == c2.hashCode());
    }
}
