
import java.time.*;

interface Chargeable {
    double chargingFee(int units);
}

class Vehicle {
    String regNo;

    Vehicle(String regNo) {
        this.regNo = regNo;
    }

    double ratePerHour() {
        return 20;
    }

    public double calculateFee(int minutes) {
        int hours = (minutes + 59) / 60;
        return hours * ratePerHour();
    }

    // Method overloading
    public double calculateFee(LocalTime in, LocalTime out) {
        int minutes = (int) Duration.between(in, out).toMinutes();
        return calculateFee(minutes);
    }
}

class TwoWheeler extends Vehicle {
    TwoWheeler(String regNo) {
        super(regNo);
    }

    @Override
    double ratePerHour() {
        return 10;
    }
}

class Car extends Vehicle {
    Car(String regNo) {
        super(regNo);
    }

    @Override
    double ratePerHour() {
        return 30;
    }
}

class ElectricCar extends Car implements Chargeable {
    ElectricCar(String regNo) {
        super(regNo);
    }

    public double chargingFee(int units) {
        return units * 12;
    }
}

public class Main {
    public static void main(String[] args) {

        Vehicle[] parked = {
            new TwoWheeler("TN01A1"),
            new Car("TN02B2"),
            new ElectricCar("TN03C3")
        };

        for (Vehicle v : parked) {
            double fee = v.calculateFee(130);

            if (v instanceof Chargeable) {
                fee += ((Chargeable) v).chargingFee(10);
            }

            System.out.println(
                v.getClass().getSimpleName() + " " +
                v.regNo + " -> Rs " + fee
            );
        }

        System.out.println(
            new Car("TN02B2").regNo.equals(
                new ElectricCar("TN02B2").regNo
            )
        );
    }
}
